{
  "$comment": "Minőségkapuk konfigurációja (docs/minosegkapuk.md). A listák bővíthetők kód-módosítás nélkül.",
  "base": "origin/main",
  "sharedFiles": [
    "docs/agent-csapdak.md",
    "AGENTS.md",
    ".claude/settings.json",
    ".github/workflows/ci.yml",
    "source/package.json",
    "source/package-lock.json"
  ],
  "sliceSharedPatterns": [
    "source/client/src/game-engine/",
    "source/shared/",
    "source/server/routes.ts",
    "source/client/src/index.css",
    "source/client/src/App.tsx"
  ],
  "games": {
    "tsunami-english": "tsunami",
    "block-craft-quiz": "block-?craft",
    "brain-rot-steal": "brain-?rot",
    "space-asteroid-quiz": "space-?asteroid",
    "speed-quiz-math": "speed-?(?:quiz|math)",
    "tornado-hunter-200": "tornado",
    "word-ladder-hu-en": "word-?ladder"
  },
  "gameOwnRoots": [
    "source/client/src/pages/",
    "source/client/src/lib/"
  ],
  "sharedGamePatterns": [
    "source/client/src/game-engine/",
    "source/client/src/pages/Games.tsx"
  ],
  "uiPatterns": [
    "source/client/src/",
    "source/client/index.html"
  ],
  "dbPatterns": [
    "source/server/",
    "source/shared/schema",
    "source/migrations/"
  ],
  "alwaysGameSpecs": [
    "game-meta-quality.spec.ts",
    "coupon-expired-all-games.spec.ts"
  ],
  "mobileQualitySpec": "game-mobile-quality.spec.ts",
  "repoWidePatterns": [
    "-guard\\.test\\.ts$",
    "^scripts/qa/",
    "^\\.github/workflows/"
  ],
  "mirroredSkills": [
    "websuli-lint-ellenor",
    "websuli-fejlesztesi-ellenor",
    "websuli-push-elotti-kapu",
    "websuli-pr-elotti-kapu",
    "websuli-merge-elotti-kapu"
  ],
  "testIntegrity": {
    "$comment": "S1 teszt-integritás kapu (docs/specs/2026-11-17-szkriptkapuk-teljes-vertikum-vegrehajtas.md S1). Regex-minták a repó-gyökérhez relatív útra.",
    "testPatterns": [
      "\\.(?:test|spec)\\.[cm]?[jt]sx?$",
      "\\.browser\\.ts$",
      "^source/tests/game-mobile-cases/",
      "^source/playwright[^/]*\\.config\\.[cm]?ts$",
      "\\.integration\\.ts$",
      "^source/tests/support/"
    ],
    "calibrationPatterns": [
      "^source/client/src/lib/[^/]+/sim\\.ts$"
    ],
    "gateFiles": [
      "^scripts/qa/gates/test-integrity\\.mjs$",
      "^scripts/qa/gates/gates\\.config\\.json$",
      "^\\.github/workflows/ci\\.yml$"
    ],
    "markerWindow": 8
  },
  "claims": {
    "$comment": "S2 hivatkozás-ellenőrző: a NEM ELLENŐRIZHETŐ hivatkozások aránya e fölött (legalább 5 hivatkozásnál) figyelmeztet.",
    "unknownWarnRatio": 0.5
  },
  "modes": {
    "$comment": "Kapunkénti mód: warn = WARN (a lánc zöld marad), block = FAIL. ALAPÉRTÉK mindenütt warn; a tiltásra váltás feltételei mérve: docs/specs/2026-11-17-szkriptkapuk-teljes-vertikum.md 6.3a.",
    "test-integrity": { "local": "warn", "ci": "warn" },
    "claims-verify": { "local": "warn", "ci": "warn" },
    "evidence-chain": { "local": "warn", "ci": "warn" }
  },
  "mergeEvidenceMaxMinutes": 15,
  "rtStatusUrl": "https://websuli.vip/api/rt/status",
  "auditSentinel": ".audit-ok",
  "auditMaxAgeMinutes": 10
}
